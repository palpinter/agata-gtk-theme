  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "scope": [
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.string",
        "punctuation.definition.parameters",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "support.function.builtin",
        "support.function.std",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "storage.type",
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fe8019"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
