{
  "name": "agata-theme",
  "displayName": "Agata",
  "publisher": "palpinter",
  "description": "Color themes matching the Agata GTK / GNOME Shell theme (Nord and Gruvbox, Dark and Light). Generated by tools/gen-app-themes.py from extras/palette.json.",
  "version": "1.0.5",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/palpinter/agata-gtk-theme"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Agata Nord Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/agata-nord-dark-color-theme.json"
      },
      {
        "label": "Agata Nord Light",
        "uiTheme": "vs",
        "path": "./themes/agata-nord-light-color-theme.json"
      },
      {
        "label": "Agata Gruvbox Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/agata-gruvbox-dark-color-theme.json"
      },
      {
        "label": "Agata Gruvbox Light",
        "uiTheme": "vs",
        "path": "./themes/agata-gruvbox-light-color-theme.json"
      }
    ]
  }
}
